# ============================================================================
#  CCJV — Backend · variables d'environnement
#  Copier ce fichier en `.env` puis renseigner les valeurs réelles.
#  ⚠️ Aucun secret ne doit être versionné : `.env` est ignoré par Git.
# ============================================================================

# --- Exécution -------------------------------------------------------------
NODE_ENV=development
PORT=4000

# --- Base de données -------------------------------------------------------
# PostgreSQL Supabase, via le pooler en mode session (port 5432).
# Le pooler est obligatoire : les projets Supabase récents exposent une
# connexion directe IPv6-only, inutilisable depuis un réseau IPv4.
# Format : postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Supabase --------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
# Clé publique : peut être exposée au navigateur, jamais utilisée pour écrire.
SUPABASE_ANON_KEY=
# Clé serveur : ne doit JAMAIS quitter le backend ni être exposée au navigateur.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ccjv-media

# --- API -------------------------------------------------------------------
API_VERSION=v1
# Origines autorisées par CORS, séparées par des virgules.
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# --- Téléversements --------------------------------------------------------
# 5 Mo par défaut.
MAX_UPLOAD_BYTES=5242880

# --- Journalisation --------------------------------------------------------
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
