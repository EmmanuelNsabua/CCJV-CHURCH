# ============================================================================
#  Frontend CCJV — variables d'environnement
#  Copier ce fichier en `.env.local` pour surcharger localement.
#  ⚠️ Ne jamais versionner de secret ici : tout ce qui commence par
#     NEXT_PUBLIC_ est exposé au navigateur.
# ============================================================================

# --- Backend API -----------------------------------------------------------
# URL de base de l'API Express (sans slash final, sans /api/v1).
# `API_URL` est résolue côté serveur (Server Components) et a la priorité.
# Elle DOIT être définie dans les variables d'environnement Vercel pour que le
# site déployé interroge le backend Railway.
API_URL=https://ccjv-api-production.up.railway.app

# Repli utilisé uniquement si `API_URL` n'est pas définie. Utile lorsque le
# frontend doit appeler l'API depuis le navigateur (préfixe NEXT_PUBLIC_).
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Site ------------------------------------------------------------------
# URL publique du site — utilisée pour canonical, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=https://ccjv.example.com
